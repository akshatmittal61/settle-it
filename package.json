{
	"name": "nextjs-template",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"node": ">=18.0.0",
		"npm": "please-use-yarn",
		"yarn": ">=1.22.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky install",
		"clean": "rm -rf .next/ && rm -rf dist/ && rm -rf .cache/ && rm -rf .yarn/ && rm -rf coverage/",
		"reset": "rm -rf .next/ && rm -rf dist/ && rm -rf .cache/ && rm -rf .yarn/ && rm -rf coverage/ && rm -rf node_modules/ && rm -rf logs/",
		"test": "jest --passWithNoTests",
		"test:watch": "jest --watch --passWithNoTests",
		"test:coverage": "jest --coverage --passWithNoTests"
	},
	"dependencies": {
		"axios": "^1.8.3",
		"dayjs": "^1.11.18",
		"google-auth-library": "^10.3.0",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^8.18.0",
		"next": "15.3.2",
		"next-pwa": "^5.6.0",
		"node-cache": "^5.1.2",
		"nodemailer": "^7.0.6",
		"otp-generator": "^4.0.1",
		"postcss": "^8",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-hot-toast": "^2.5.1",
		"react-icons": "^5.5.0",
		"tailwindcss": "^3.4.1",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.6.1",
		"@commitlint/config-conventional": "^19.6.0",
		"@eslint/eslintrc": "^3",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/node": "^20",
		"@types/nodemailer": "^6.4.17",
		"@types/otp-generator": "^4.0.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^8",
		"eslint-config-next": "^15.1.6",
		"husky": "^9.1.7",
		"prettier": "^3.4.2",
		"sass": "^1.70.0",
		"typescript": "^5"
	}
}
